# Replace every CHANGE_ME value with a cryptographically random secret before deployment.
# Suggested generator: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_at_least_64_random_characters
DEBUG=false

DB_PASSWORD=CHANGE_ME_generate_32_random_characters
# Non-superuser application DB role; migrations run separately as kravigil_admin.
APP_DB_PASSWORD=CHANGE_ME_generate_32_random_characters
BACKUP_ENCRYPTION_KEY=CHANGE_ME_generate_32_random_characters
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
MINIO_BACKUP_BUCKET=kravigil-backups
REDIS_PASSWORD=CHANGE_ME_generate_32_random_characters

MINIO_USER=CHANGE_ME_minio_admin
MINIO_PASSWORD=CHANGE_ME_generate_32_random_characters
MINIO_BUCKET=kravigil-evidence
GRAFANA_PASSWORD=CHANGE_ME_generate_24_random_characters

GEMINI_API_KEY=
OTX_API_KEY=

# Optional cloud-scan credentials. Prefer short-lived credentials / workload identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=

# Shared secret for the authenticated TLS-protected C++ gRPC engine.
KRAVIGIL_ENGINE_AUTH_TOKEN=CHANGE_ME_generate_64_random_characters

# Public application URL and exact browser origins (JSON array).
FRONTEND_URL=https://kravigil.example.com
ALLOWED_ORIGINS=["https://kravigil.example.com"]
# Explicit private/internal ranges that administrators are authorized to scan.
ALLOWED_SCAN_CIDRS=[]

# Initial administrator: use a unique password of at least 12 characters
# with uppercase, lowercase and digits. Never commit the real .env file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_use_a_unique_strong_password

# SMTP is required for password-reset email in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_USE_TLS=true

# MinIO replication settings
MINIO_SOURCE_URL=http://minio:9000
MINIO_TARGET_URL=http://target-minio:9000
MINIO_SOURCE_USER=CHANGE_ME_source_user
MINIO_SOURCE_PASSWORD=CHANGE_ME_source_password
MINIO_TARGET_USER=CHANGE_ME_target_user
MINIO_TARGET_PASSWORD=CHANGE_ME_target_password
